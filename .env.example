DATABASE_URL="postgresql://idvet:idvet@localhost:5434/idvet"

# Admin dashboard (/admin)
ADMIN_EMAIL="admin@idvet.co"
ADMIN_PASSWORD="change-me"
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=""

# Where uploaded images and PDFs are stored (outside public/). Default: ./storage/uploads
UPLOAD_DIR="./storage/uploads"

# Email (lib/mailer.ts): contact form + quote requests. Leave SMTP_HOST empty to
# skip sending; submissions are still saved in the database.
SMTP_HOST="mail.idvet.co"
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT="465"
SMTP_USER="admin@idvet.co"
SMTP_PASS=""
# Sender, e.g. "IDVET Website <no-reply@idvet.co>" (default: SMTP_USER)
MAIL_FROM="IDVET Website <admin@idvet.co>"
MAIL_TO="admin@idvet.co, info@idvet.co"
