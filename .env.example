DATABASE_URL="postgresql://idvet:idvet@localhost:5434/idvet"

# Admin dashboard (/admin)
ADMIN_EMAIL="admin@idvet.co"
ADMIN_PASSWORD="change-me"
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=""

# Where uploaded images and PDFs are stored (outside public/). Default: ./storage/uploads
UPLOAD_DIR="./storage/uploads"

# Origin for links and images in notification emails.
SITE_URL="https://idvet.co"

# Email (lib/mailer.ts): contact form and quote requests each use their own
# account on the same server. Submissions are always saved in the database;
# leave SMTP_HOST empty to skip emailing. If the port fails, 587 + STARTTLS is tried.
SMTP_HOST="mail.idvet.co"
SMTP_PORT="465"
SMTP_SECURE="true"
# Contact form -> info@idvet.co. The From address is always the SMTP user;
# *_MAIL_FROM only sets the display name.
CONTACT_SMTP_USER="info@idvet.co"
CONTACT_SMTP_PASS=""
CONTACT_MAIL_FROM="IDVET Website <info@idvet.co>"
CONTACT_MAIL_TO="info@idvet.co"
# Quote requests -> notification@idvet.co
QUOTE_SMTP_USER="notification@idvet.co"
QUOTE_SMTP_PASS=""
QUOTE_MAIL_FROM="IDVET Website <notification@idvet.co>"
QUOTE_MAIL_TO="notification@idvet.co"
