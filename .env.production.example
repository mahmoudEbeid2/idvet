# Production Environment Variables for IDVET
# Copy this file to .env on your production server:
# cp .env.production.example .env

# Database Credentials
POSTGRES_USER=idvet
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=idvet

# Prisma Database URL (connected to the 'db' container on port 5432)
DATABASE_URL=postgresql://idvet:change_this_to_a_secure_password@db:5432/idvet

# Domain and Site Settings
NEXT_PUBLIC_SITE_URL=https://idvet.co
ACME_EMAIL=info@idvet.co

# Admin dashboard (/admin)
ADMIN_EMAIL=admin@idvet.co
ADMIN_PASSWORD=change_this_to_a_strong_password
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# Uploaded files. docker-compose sets this to /app/storage/uploads (the idvet_uploads volume).
UPLOAD_DIR=/app/storage/uploads

# Email (lib/mailer.ts): contact form + quote requests. Leave SMTP_HOST empty to
# skip sending; submissions are still saved in the database.
SMTP_HOST=""
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# Sender, e.g. "IDVET Website <no-reply@idvet.co>" (default: SMTP_USER)
MAIL_FROM=""
MAIL_TO="info@idvet.co"
