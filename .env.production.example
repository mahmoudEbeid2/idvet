# Production Environment Variables for IDVET
# Copy this file to .env on your production server:
# cp .env.production.example .env

# Database Credentials
POSTGRES_USER=idvet
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=idvet

# Prisma Database URL (connected to the 'db' container on port 5432)
DATABASE_URL=postgresql://idvet:change_this_to_a_secure_password@db:5432/idvet

# Domain and Site Settings
NEXT_PUBLIC_SITE_URL=https://idvet.co
ACME_EMAIL=info@idvet.co

# Admin dashboard (/admin)
ADMIN_EMAIL=admin@idvet.co
ADMIN_PASSWORD=change_this_to_a_strong_password
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# Uploaded files. docker-compose sets this to /app/storage/uploads (the idvet_uploads volume).
UPLOAD_DIR=/app/storage/uploads

# Origin for links and images in notification emails.
SITE_URL="https://idvet.co"

# Email (lib/mailer.ts): contact form and quote requests each use their own
# account on the same server. Submissions are always saved in the database;
# leave SMTP_HOST empty to skip emailing. If the port fails, 587 + STARTTLS is tried.
SMTP_HOST="mail.idvet.co"
SMTP_PORT="465"
SMTP_SECURE="true"
# Contact form -> info@idvet.co. The From address is always the SMTP user;
# *_MAIL_FROM only sets the display name.
CONTACT_SMTP_USER="info@idvet.co"
CONTACT_SMTP_PASS=""
CONTACT_MAIL_FROM="IDVET Website <info@idvet.co>"
CONTACT_MAIL_TO="info@idvet.co"
# Quote requests -> notification@idvet.co
QUOTE_SMTP_USER="notification@idvet.co"
QUOTE_SMTP_PASS=""
QUOTE_MAIL_FROM="IDVET Website <notification@idvet.co>"
QUOTE_MAIL_TO="notification@idvet.co"
